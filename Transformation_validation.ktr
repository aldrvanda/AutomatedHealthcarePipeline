  <step>
    <name>Formula</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>age_group</field_name>
      <formula_string>IF([age]&lt;=25;"Youth";IF([age]&lt;=45;"Adult";IF([age]&lt;=65;"Senior";"Elderly")))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>condition_category</field_name>
      <formula_string>IF(OR([medical_condition]="Cancer";[medical_condition]="Diabetes";[medical_condition]="Asthma";[medical_condition]="Arthritis");"Chronic";"Metabolic")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>billing_band</field_name>
      <formula_string>IF([billing_amount]&lt;=9999;"Low";IF([billing_amount]&lt;=29999;"Medium";"High"))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>is_weekend</field_name>
      <formula_string>IF(OR(WEEKDAY([date_of_admission])=1;WEEKDAY([date_of_admission])=7);"Y";"N")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>date_key</field_name>
      <formula_string>YEAR([date_of_admission])*10000+MONTH([date_of_admission])*100+DAY([date_of_admission])</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
