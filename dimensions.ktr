    <formula>
      <field_name>quarter</field_name>
      <formula_string>IF([admit_month]&lt;=3;1;IF([admit_month]&lt;=6;2;IF([admit_month]&lt;=9;3;4)))</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>weekday_name</field_name>
      <formula_string>IF([weekday_num]=1;"Sunday";IF([weekday_num]=2;"Monday";IF([weekday_num]=3;"Tuesday";IF([weekday_num]=4;"Wednesday";IF([weekday_num]=5;"Thursday";IF([weekday_num]=6;"Friday";"Saturday"))))))</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
